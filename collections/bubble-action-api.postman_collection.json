        {
          "id": "cbdd4184-ded2-47cd-9aef-88bba2287ab5",
          "name": "Invoke Client-Side Action",
          "request": {
            "name": "Invoke Client-Side Action",
            "description": {
              "content": "Client-side actions are written as `function(properties, context)` and\nrun in the browser. Useful for DOM manipulation, calling browser\nAPIs, or working with already-loaded data. No workload is incurred\nbecause no server roundtrip occurs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actions",
                "clientSide",
                ":actionName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "actionName",
                  "description": "(Required) Name of the action as defined in the plugin editor."
                },
                {
                  "description": "Bubble app name",
                  "type": "any",
                  "value": "{{appname}}",
                  "key": "appname"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"key_0\": \"string\",\n    \"key_1\": true\n  },\n  \"context\": {\n    \"key_0\": true,\n    \"key_1\": 9753.196454802312\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
