{
  "item": [
    {
      "id": "ad28d457-39aa-44e5-a5a1-6bdde5569e52",
      "name": "Action",
      "description": {
        "content": "Server-side and client-side action functions invoked by Bubble workflows.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ea649869-1b97-4cdb-b297-f4334e64e918",
          "name": "Invoke Server-Side Action",
          "request": {
            "name": "Invoke Server-Side Action",
            "description": {
              "content": "Server-side actions are written as `function(properties, context)`.\nThey run in a Node.js sandbox, may `require` configured npm\ndependencies, and may return data consumed by subsequent workflow\nsteps. Counts as 1 server-side plugin action call (0.2 WU base + per-ms).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actions",
                "serverSide",
                ":actionName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "actionName",
                  "description": "(Required) Name of the action as defined in the plugin editor."
                },
                {
                  "description": "Bubble app name",
                  "type": "any",
                  "value": "{{appname}}",
                  "key": "appname"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"key_0\": 1675,\n    \"key_1\": 4796.554558471915\n  },\n  \"context\": {\n    \"currentUser\": {\n      \"id\": \"<string>\",\n      \"listProperties\": \"<string>\",\n      \"get\": \"<string>\",\n      \"getAll\": \"<string>\"\n    },\n    \"userTimezone\": \"<string>\",\n    \"keys\": {\n      \"key_0\": \"<string>\",\n      \"key_1\": \"<string>\"\n    },\n    \"isBubbleThing\": \"<string>\",\n    \"isBubbleList\": \"<string>\",\n    \"getThingById\": \"<string>\",\n    \"getThingsById\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "010b7651-46fa-452b-9d6b-0f179c9e1113",
              "name": "Action returned successfully. Return shape is defined by the plugin's `Returned values` configuration.",
