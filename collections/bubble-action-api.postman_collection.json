                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"properties\": {\n    \"key_0\": \"string\",\n    \"key_1\": 7859\n  },\n  \"context\": {\n    \"currentUser\": {\n      \"id\": \"<string>\",\n      \"listProperties\": \"<string>\",\n      \"get\": \"<string>\",\n      \"getAll\": \"<string>\"\n    },\n    \"userTimezone\": \"<string>\",\n    \"keys\": {\n      \"key_0\": \"<string>\",\n      \"key_1\": \"<string>\"\n    },\n    \"isBubbleThing\": \"<string>\",\n    \"isBubbleList\": \"<string>\",\n    \"getThingById\": \"<string>\",\n    \"getThingsById\": \"<string>\"\n  }\n}",
