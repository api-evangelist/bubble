  "info": {
    "_postman_id": "689bc05c-0ab4-44a0-8fcc-c799d16e59fa",
    "name": "Bubble Data Action Element API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Bubble Data API exposes the database of a Bubble app as a REST interface.\nExternal systems can read, search, create, modify, replace, and delete records\nof any data type defined in a Bubble app, with optional pagination, sorting,\nand search constraints. Authentication uses bearer tokens (admin API tokens\nbypass privacy rules; user tokens enforce them). Endpoints exist for live and\ndevelopment (`version-test`) environments.\n\n\nContact Support:\n Name: Bubble Support",
      "type": "text/plain"
    }
  }
