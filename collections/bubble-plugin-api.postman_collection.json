    {
      "id": "3bc8a631-d0b0-4f4b-99f7-c9930b899730",
      "name": "Action",
      "description": {
        "content": "Server-side and client-side action functions invoked by Bubble workflows.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a49a9b6d-b924-4207-846a-b204403cbcf4",
          "name": "Invoke Server-Side Action",
          "request": {
            "name": "Invoke Server-Side Action",
            "description": {
              "content": "Server-side actions are written as `function(properties, context)`.\nThey run in a Node.js sandbox, may `require` configured npm\ndependencies, and may return data consumed by subsequent workflow\nsteps. Counts as 1 server-side plugin action call (0.2 WU base + per-ms).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actions",
                "serverSide",
                ":actionName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "actionName",
                  "description": "(Required) Name of the action as defined in the plugin editor."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"key_0\": \"string\",\n    \"key_1\": \"string\"\n  },\n  \"context\": {\n    \"currentUser\": {\n      \"id\": \"<string>\",\n      \"listProperties\": \"<string>\",\n      \"get\": \"<string>\",\n      \"getAll\": \"<string>\"\n    },\n    \"userTimezone\": \"<string>\",\n    \"keys\": {\n      \"key_0\": \"<string>\",\n      \"key_1\": \"<string>\",\n      \"key_2\": \"<string>\",\n      \"key_3\": \"<string>\"\n    },\n    \"isBubbleThing\": \"<string>\",\n    \"isBubbleList\": \"<string>\",\n    \"getThingById\": \"<string>\",\n    \"getThingsById\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "04525755-c84c-423d-af2d-fbf731eb1349",
