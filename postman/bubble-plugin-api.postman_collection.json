                        ":actionName"
                      ],
                      "variable": [
                        {
                          "id": "965da6c0-7296-459a-b070-8f080baf7528",
                          "key": "actionName",
                          "value": "<string>",
                          "description": "(Required) Name of the action as defined in the plugin editor."
                        }
                      ]
                    },
                    "description": "Server-side actions are written as `function(properties, context)`.\nThey run in a Node.js sandbox, may `require` configured npm\ndependencies, and may return data consumed by subsequent workflow\nsteps. Counts as 1 server-side plugin action call (0.2 WU base + per-ms).\n"
                  },
