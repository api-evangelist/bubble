{
  "info": {
    "_postman_id": "3f0855d5-de39-476a-94a6-56a8687270b4",
    "name": "Bubble Workflow API",
    "description": "The Bubble Workflow API lets external systems trigger backend workflows\ndefined in a Bubble app. Each workflow is exposed at a path of the form\n`/api/1.1/wf/{workflow_name}` and may be invoked via POST or GET. Authentication\nrequirements are configurable per workflow (none, user/admin, or admin only).\nWorkflows can return structured JSON, plain text, custom content, or HTTP\nredirects on success/error.\n\n\nContact Support:\n Name: Bubble Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:00:38.000Z",
    "updatedAt": "2026-06-05T15:00:38.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-3f0855d5-de39-476a-94a6-56a8687270b4"
  },
